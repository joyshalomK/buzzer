# Supabase → Project Settings → API
# Both values are PUBLIC by design (they ship to the browser).
# NEVER put the service_role key or the admin password here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: base URL encoded in the QR code (defaults to the current origin).
# Useful when the admin opens the app on localhost but phones use the LAN IP / Vercel URL.
VITE_PUBLIC_BASE_URL=
